<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 相機預覽 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 取景框覆蓋層：暗遮罩＋四角括號＋掃描線＋命中閃色（與全盤共用） -->
    <com.example.myapplication.ui.ScannerOverlayView
        android:id="@+id/scanner_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 頂部資訊條：顯示要找的資產 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <!-- 抽盤目標標記（脈動點＋標籤） -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <View
                android:id="@+id/target_pulse"
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/circle_target_pulse" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="抽盤目標"
                android:textColor="@color/evergreen_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_target_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/tv_target_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:layout_marginTop="1dp" />

        <TextView
            android:id="@+id/tv_target_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#AEBFB6"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 掃描提示（取景框下方，隨情境變化） -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="112dp"
        android:text="對準指定財產 QR Code"
        android:textColor="@color/text_on_primary"
        android:textSize="13sp"
        android:background="@drawable/bg_hint_overlay"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp" />

    <!-- 待確認遮罩：不相符待使用者確認期間，暗化相機並提示掃描暫停（在結果卡之下，
         讓卡片的確認／略過鈕仍可點） -->
    <FrameLayout
        android:id="@+id/awaiting_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scan_await_scrim"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_awaiting_pill"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/circle_awaiting_dot" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="等待確認中，掃描暫停"
                android:textColor="@color/scan_flash_error"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- 掃描結果回饋卡（綠／橘／紅），浮在底部操作列上方、遮罩之上 -->
    <com.example.myapplication.ui.ScanResultCard
        android:id="@+id/scan_result_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="104dp" />

    <!-- ══ 底部操作列：補光 / 拍照存證 / 返回（原型樣式：暗色列＋圖示座＋線性圖示） ══ -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:background="@drawable/bg_scan_bar"
        android:paddingVertical="14dp"
        android:paddingHorizontal="8dp">

        <!-- 補光 -->
        <LinearLayout
            android:id="@+id/btn_torch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <FrameLayout
                android:id="@+id/chip_torch"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_scan_chip">
                <ImageView
                    android:id="@+id/ic_torch"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_flash"
                    android:tint="@color/scan_ico_dim"
                    android:contentDescription="補光" />
            </FrameLayout>
            <TextView
                android:id="@+id/lbl_torch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="補光"
                android:textColor="@color/scan_label"
                android:textSize="12sp"
                android:layout_marginTop="7dp" />
        </LinearLayout>

        <!-- 拍照存證 -->
        <LinearLayout
            android:id="@+id/btn_capture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_scan_chip">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/scan_ico"
                    android:contentDescription="拍照存證" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="拍照存證"
                android:textColor="@color/scan_label"
                android:textSize="12sp"
                android:layout_marginTop="7dp" />
        </LinearLayout>

        <!-- 返回 -->
        <LinearLayout
            android:id="@+id/btn_cancel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_scan_chip">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/scan_ico"
                    android:contentDescription="返回" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="返回"
                android:textColor="@color/scan_label"
                android:textSize="12sp"
                android:layout_marginTop="7dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 相機權限被拒的引導畫面（覆蓋整頁，預設隱藏） -->
    <include
        android:id="@+id/permission_denied"
        layout="@layout/view_permission_denied"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
