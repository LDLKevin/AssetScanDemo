<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 相機預覽 -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 取景框覆蓋層：暗遮罩＋四角括號＋掃描線＋命中閃色（與全盤共用） -->
    <com.example.myapplication.ui.ScannerOverlayView
        android:id="@+id/scanner_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 頂部資訊條：顯示要找的資產 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#CC000000"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <!-- 品牌標識 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EVERGREEN"
            android:textColor="@color/evergreen_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 正在尋找"
            android:textColor="#CCCCCC"
            android:textSize="12sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_target_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_on_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_target_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E0E0E0"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- 掃描提示（移到取景框下方，避免與掃描線重疊） -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="96dp"
        android:text="對準 QR Code"
        android:textColor="@color/text_on_primary"
        android:textSize="13sp"
        android:background="@drawable/bg_hint_overlay"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp" />

    <!-- 手電筒按鈕 -->
    <TextView
        android:id="@+id/btn_torch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="120dp"
        android:layout_marginEnd="16dp"
        android:text="🔦"
        android:textSize="22sp"
        android:gravity="center"
        android:background="@drawable/circle_overlay"
        android:clickable="true"
        android:focusable="true" />

    <!-- 掃描結果回饋卡（綠／橘／紅），浮在取消鍵上方 -->
    <com.example.myapplication.ui.ScanResultCard
        android:id="@+id/scan_result_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="96dp" />

    <!-- 底部取消按鈕 -->
    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="20dp"
        android:text="取消"
        android:textColor="@color/text_on_primary"
        android:background="@drawable/btn_secondary" />

    <!-- 相機權限被拒的引導畫面（覆蓋整頁，預設隱藏） -->
    <include
        android:id="@+id/permission_denied"
        layout="@layout/view_permission_denied"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>