<?xml version="1.0" encoding="utf-8"?>
<!-- 掃描結果卡內容；被 ScanResultCard（FrameLayout）inflate。底色與文字色由程式依狀態設定。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_result_card"
    android:backgroundTint="@color/status_success_bg"
    android:elevation="6dp"
    android:padding="18dp">

    <TextView
        android:id="@+id/result_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/result_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="13sp" />

    <!-- 差異對比（不相符時顯示，逐列由程式加入） -->
    <LinearLayout
        android:id="@+id/result_diff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="10dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/result_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_on_primary"
        android:visibility="gone" />

    <Button
        android:id="@+id/result_dismiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="略過（不寫入）"
        android:textColor="@color/text_secondary"
        android:background="@android:color/transparent"
        android:visibility="gone" />

</LinearLayout>
